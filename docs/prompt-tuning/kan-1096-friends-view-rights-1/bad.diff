+package com.gymie
+
+import com.gymie.common.domain.access.AccessLevel
+import com.gymie.common.domain.access.AccessScope
+import com.gymie.common.domain.access.Owner
+import com.gymie.common.web.owner.OwnerAccess
+import com.gymie.invite.core.ports.persistence.invite.InviteRepository
+import com.gymie.invite.core.ports.security.InviteTokenCodec
+import com.gymie.invite.core.services.invite.InviteService
+import com.gymie.support.AuthIntegrationTestSupport
+import com.jayway.jsonpath.JsonPath
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.beans.factory.annotation.Qualifier
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc
+import org.springframework.data.redis.core.StringRedisTemplate
+import org.springframework.http.HttpHeaders
+import org.springframework.http.HttpMethod
+import org.springframework.http.MediaType
+import org.springframework.jdbc.core.JdbcTemplate
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.request
+import org.springframework.web.method.HandlerMethod
+import org.springframework.web.servlet.mvc.method.annotation.RequestMappingHandlerMapping
+import java.util.UUID
+
+/**
+ * The rights check over the assembled application (decisions `owner-argument-resolver`,
+ * `by-id-names-the-owner`): every route that takes an `Owner` refuses a stranger and a friend one level
+ * too low with `403 grant_revoked` before it reads anything, and a by-id route named under friend A
+ * answers `404` for friend B's row although A gives the caller Training Edit.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+@ActiveProfiles("test")
+class FriendRightsMatrixIntegrationTest : AppIntegrationTest() {
+    @Autowired lateinit var mockMvc: MockMvc
+
+    @Autowired lateinit var jdbc: JdbcTemplate
+
+    @Autowired lateinit var redis: StringRedisTemplate
+
+    @Autowired lateinit var inviteService: InviteService
+
+    @Autowired lateinit var inviteRepository: InviteRepository
+
+    @Autowired lateinit var inviteTokenCodec: InviteTokenCodec
+
+    @Autowired
+    @Qualifier("requestMappingHandlerMapping")
+    lateinit var mapping: RequestMappingHandlerMapping
+
+    private lateinit var support: AuthIntegrationTestSupport
+
+    @BeforeEach
+    fun setUp() {
+        support = AuthIntegrationTestSupport(jdbc, redis, inviteService, inviteRepository, inviteTokenCodec)
+        support.cleanup()
+    }
+
+    @AfterEach
+    fun tearDown() {
+        support.cleanup()
+    }
+
+    @Test
+    fun `a stranger and a friend one level too low get 403 on every Owner route`() {
+        val (viewer, token) = registerAccount("viewer")
+        // a: Training Edit, Body Read, Training setup Read. b: Training Edit, Body none.
+        // d: Body Edit, Training none. c: a stranger who gives nothing.
+        val a = registerAccount("friend-a").first
+        val b = registerAccount("friend-b").first
+        val d = registerAccount("friend-d").first
+        val c = registerAccount("stranger-c").first
+        grant(a, viewer, workouts = "EDIT", body = "READ", setup = "READ")
+        grant(b, viewer, workouts = "EDIT", body = "NONE", setup = "EDIT")
+        grant(d, viewer, workouts = "NONE", body = "EDIT", setup = "NONE")
+        val oneLevelTooLow =
+            mapOf(
+                (AccessScope.WORKOUTS to AccessLevel.EDIT) to d,
+                (AccessScope.BODY to AccessLevel.READ) to b,
+                (AccessScope.BODY to AccessLevel.EDIT) to a,
+                (AccessScope.TRAINING_SETUP to AccessLevel.READ) to d,
+                (AccessScope.TRAINING_SETUP to AccessLevel.EDIT) to a,
+            )
+
+        val routes = ownerRoutes()
+        assertThat(routes).hasSizeGreaterThan(OWNER_ROUTES_AT_LEAST)
+        val refusals =
+            routes.flatMap { route ->
+                val access = route.access
+                val tooLow = oneLevelTooLow.getValue(access.scope to access.level)
+                listOf(c, tooLow).map { ownerId ->
+                    "${route.describe()} ownerId=$ownerId" to call(route, token, ownerId, UUID.randomUUID())
+                }
+            }
+
+        assertThat(refusals.filterNot { (_, answer) -> answer.status == FORBIDDEN && answer.body.contains("grant_revoked") })
+            .describedAs("routes that did not refuse with 403 grant_revoked")
+            .isEmpty()
+    }
+
+    @Test
+    fun `friend A's Edit does not reach friend B's workout on any by-id route`() {
+        val (viewer, token) = registerAccount("viewer")
+        val a = registerAccount("friend-a").first
+        val (b, bToken) = registerAccount("friend-b")
+        grant(a, viewer, workouts = "EDIT", body = "NONE", setup = "EDIT")
+        grant(b, viewer, workouts = "EDIT", body = "NONE", setup = "EDIT")
+        val hers = create(bToken, "/api/workouts", WORKOUT_BODY)
+
+        assertNotFoundOnEveryByIdRoute("/api/workouts", token, a, hers)
+    }
+
+    @Test
+    fun `friend A's Edit does not reach friend B's cardio by id`() {
+        val (viewer, token) = registerAccount("viewer")
+        val a = registerAccount("friend-a").first
+        val (b, bToken) = registerAccount("friend-b")
+        grant(a, viewer, workouts = "EDIT", body = "NONE", setup = "EDIT")
+        grant(b, viewer, workouts = "EDIT", body = "NONE", setup = "EDIT")
+        val hers = create(bToken, "/api/cardio-workouts", CARDIO_BODY)
+
+        assertNotFoundOnEveryByIdRoute("/api/cardio-workouts", token, a, hers)
+    }
+
+    private fun assertNotFoundOnEveryByIdRoute(
+        prefix: String,
+        token: String,
+        ownerId: UUID,
+        id: UUID,
+    ) {
+        val byId = ownerRoutes().filter { it.pattern.startsWith("$prefix/{id}") }
+        assertThat(byId).isNotEmpty
+        val answers = byId.map { route -> route.describe() to call(route, token, ownerId, id) }
+
+        assertThat(answers.filterNot { (_, answer) -> answer.status == NOT_FOUND })
+            .describedAs("by-id routes that did not answer 404 for another friend's row")
+            .isEmpty()
+    }
+
+    private data class Route(
+        val method: HttpMethod,
+        val pattern: String,
+        val access: OwnerAccess,
+    ) {
+        fun describe() = "$method $pattern"
+    }
+
+    private data class Answer(
+        val status: Int,
+        val body: String,
+    )
+
+    /** Every handler taking an `Owner`, with the access its `@OwnerAccess` asks for. */
+    private fun ownerRoutes(): List<Route> =
+        mapping.handlerMethods.flatMap { (info, handler) ->
+            val access = handler.ownerAccess() ?: return@flatMap emptyList()
+            info.patternValues.flatMap { pattern ->
+                info.methodsCondition.methods.map { Route(HttpMethod.valueOf(it.name), pattern, access) }
+            }
+        }
+
+    private fun HandlerMethod.ownerAccess(): OwnerAccess? =
+        methodParameters.firstOrNull { it.parameterType == Owner::class.java }?.getParameterAnnotation(OwnerAccess::class.java)
+
+    /** [route] with `{id}` as [id] and any other path variable a fresh id, a body the route accepts, and `?ownerId=`. */
+    private fun call(
+        route: Route,
+        token: String,
+        ownerId: UUID,
+        id: UUID,
+    ): Answer {
+        val path = route.pattern.replace("{id}", id.toString()).replace(Regex("\\{[^}]+}"), UUID.randomUUID().toString())
+        val result =
+            mockMvc
+                .perform(
+                    request(route.method, path)
+                        .param("ownerId", ownerId.toString())
+                        .param("from", "2026-11-09")
+                        .param("to", "2026-11-15")
+                        .param("preset", "4W")
+                        .header(HttpHeaders.AUTHORIZATION, "Bearer $token")
+                        .header(HttpHeaders.IF_MATCH, "\"2026-11-13T08:00:00Z\"")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(BODIES[route.describe()] ?: "{}"),
+                ).andReturn()
+        return Answer(result.response.status, result.response.contentAsString)
+    }
+
+    private fun create(
+        token: String,
+        path: String,
+        body: String,
+    ): UUID {
+        val result =
+            mockMvc
+                .perform(
+                    request(HttpMethod.POST, path)
+                        .header(HttpHeaders.AUTHORIZATION, "Bearer $token")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(body),
+                ).andReturn()
+        assertThat(result.response.status).describedAs(result.response.contentAsString).isEqualTo(CREATED)
+        return UUID.fromString(JsonPath.read(result.response.contentAsString, "$.id"))
+    }
+
+    private fun registerAccount(slug: String): Pair<UUID, String> {
+        val email = "$slug@example.com"
+        val token = support.readAccessToken(support.registerVerified(mockMvc, email, nickname = slug))
+        val userId = UUID.fromString(jdbc.queryForObject("""SELECT id FROM "user" WHERE email = ?""", String::class.java, email))
+        return userId to token
+    }
+
+    /** Grants are seeded directly: the matrix is about the read side of a grant, not the rights UI. */
+    private fun grant(
+        grantorId: UUID,
+        granteeId: UUID,
+        workouts: String,
+        body: String,
+        setup: String,
+    ) {
+        jdbc.update(
+            "INSERT INTO access_grant (grantor_id, grantee_id, workouts_level, body_level, training_setup_level) VALUES (?, ?, ?, ?, ?)",
+            grantorId,
+            granteeId,
+            workouts,
+            body,
+            setup,
+        )
+    }
+
+    private companion object {
+        const val CREATED = 201
+        const val FORBIDDEN = 403
+        const val NOT_FOUND = 404
+
+        /** Workouts, cardio, body and Training setup together take far more than this many `Owner` routes. */
+        const val OWNER_ROUTES_AT_LEAST = 20
+
+        const val WORKOUT_BODY = """{"scheduledDate":"2026-11-13","blocks":[{"type":"TEXT","text":"Warm up"}]}"""
+        const val CARDIO_BODY =
+            """{"scheduledDate":"2026-11-13","activity":"OUTDOOR_RUN","kind":"EASY",""" +
+                """"steps":[{"type":"WORK","length":{"kind":"TIME","seconds":1800}}]}"""
+
+        /** A body each by-id route accepts, so its answer is the ownership check's and not validation's. */
+        val BODIES =
+            mapOf(
+                "PUT /api/workouts/{id}" to WORKOUT_BODY,
+                "PATCH /api/workouts/{id}" to """{"notes":null}""",
+                "PATCH /api/workouts/{id}/blocks/{blockId}" to """{"collapsed":false,"completed":true}""",
+                "PATCH /api/workouts/{id}/exercises/{exerciseId}" to """{"note":"x","evaluation":null,"evaluationNote":null}""",
+                "PATCH /api/workouts/{id}/sets/{setId}" to
+                    """{"weight":{"kind":"MEASURED","value":42.5},"effort":{"kind":"COUNT","value":8},"confirmed":true}""",
+                "POST /api/workouts/{id}/copy" to """{"targetDate":"2026-11-14"}""",
+                "PUT /api/workouts/{id}/exercises/{rowId}/evaluation" to """{"move":"KEEP"}""",
+                "PUT /api/cardio-workouts/{id}" to CARDIO_BODY,
+                "PATCH /api/cardio-workouts/{id}" to """{"notes":null}""",
+                "POST /api/cardio-workouts/{id}/copy" to """{"targetDate":"2026-11-14"}""",
+                "PUT /api/cardio-workouts/{id}/log" to """{"durationSeconds":1800}""",
+            )
+    }
+}
