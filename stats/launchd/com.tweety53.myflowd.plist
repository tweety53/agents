<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User launchd agent for myflowd, the myflow stats daemon.

  Starts myflowd at login and restarts it if it exits with a non-zero
  status (KeepAlive/SuccessfulExit=false below) -- a clean exit (for
  example `launchctl stop`) is never restarted, only a crash or failure
  is. Binds loopback only, per stats/internal/config/config.go's
  Config.Validate -- this agent starts the same binary with no additional
  privilege and no network exposure beyond what myflowd already refuses to
  violate at startup.

  Loading this agent is a deliberate OPERATOR step, documented in
  stats/README.md -- no skill or command in this repository loads it.
  Install it by hand:

      cp stats/launchd/com.tweety53.myflowd.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.tweety53.myflowd.plist

  See stats/README.md for the full operator procedure, including building
  the binary this agent points at and how to stop it.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tweety53.myflowd</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/tweety53/Projects/agents/stats/bin/myflowd</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/tweety53/Projects/agents/stats</string>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/tweety53/Library/Logs/myflowd.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/tweety53/Library/Logs/myflowd.log</string>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
