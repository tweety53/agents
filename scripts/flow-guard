#!/usr/bin/env bash
# scripts/flow-guard — the one bootstrap every guard runs through:
#
#   scripts/flow-guard <name> [arguments]
#
# execs `flow-guard <name>` built from the very checkout this file lives in
# (design.md's guard-binary-built-from-checkout). It exports
# FLOW_GUARD_REPO_ROOT, the physical root of that checkout, over any value it
# inherited: a guard run by another guard, or by a lint command another
# checkout's guard started, judges the checkout its own bootstrap sits in,
# never its caller's. Each guard's contract is the leading comment of its Go file
# under stats/internal/guard/. `setup.sh global` installs one PATH shim,
# ~/.local/bin/flow-guard, onto this file; its root is `cd -P` of this file's
# directory's parent, reached through any symlink to this file, so a call
# through a symlink still answers the checkout.
#
# WHY BUILD FROM THE CHECKOUT. A bash guard was its own source: the skills'
# scripts/ symlink into the checkout, so a guard edit merged to main was in
# force on the next call. A flow-guard installed once to a PATH directory is
# not — it keeps enforcing whatever it was built from until someone rebuilds
# it by hand, and nothing reports the skew, so a check added since silently
# does not run (panel round 0, F1/F8). An install step also has no place to
# run where a merge lands, so a machine that never ran it has guards that
# cannot answer at all (F2). Deriving the binary at the point of use closes
# both: there is no installed copy to go stale and no install step to miss.
#
# THE KEY. The cache key is the SHA-256 of the per-file SHA-256 lines of
# exactly the sources the binary is built from — stats/go.mod, stats/go.sum,
# and the non-test .go files of stats/cmd/flow-guard/, stats/internal/guard/,
# stats/internal/records/, stats/internal/modelpolicy/,
# stats/internal/testcost/ and stats/internal/shlex/ (the only packages
# it imports from this module: unfinishedwork.go imports records,
# modelpolicy.go and loop.go modelpolicy,
# testcost.go testcost, hookblockunsafecommands.go shlex) — named relative to stats/, so two
# checkouts with the same sources share one binary and a _test.go edit never
# forces a rebuild. A tree without one of those packages keys without it.
# The binary lives at
# <cache>/<key>/flow-guard, where <cache> is FLOW_GUARD_CACHE_DIR if set (the
# test suites point it at a temporary directory, so no test writes into the
# operator's real cache), else ${XDG_CACHE_HOME:-$HOME/.cache}/flow-guard.
# Each source edit adds one key of a few MB; the binary itself prunes keys
# unused for a week (stats/cmd/flow-guard/prune.go), and removing the
# directory is always safe.
#
# THE STAMP FILE. Hashing every source costs most of a call, so the key is
# cached per checkout in <cache>/stamp<stats path, each / as %>: the key on
# its first line, the hashed file names on its second, its mtime the moment
# before that hashing began. A call whose file list matches the second line,
# whose stamp is strictly newer than every source (bash's test -nt, no fork)
# and whose key's binary is cached uses that key without hashing; any other
# call hashes and, once the binary stands, rewrites the stamp. An edit, an
# added file or a deleted one therefore always rehashes. An edit that sets a
# source's mtime back before the stamp (touch -t, cp -p) is not seen; remove
# the stamp, or the cache, to force the hash.
#
# THE BUILD. A missing key is built with `go build` to a pid-named temporary
# file in the key's directory and moved into place with `mv -f`, a rename
# within one directory — atomic, so concurrent first calls each build and the
# last rename wins with an identical binary, and no caller ever execs a
# half-written file. The key is recomputed after the build; if the sources
# changed while it ran, the binary is discarded rather than cached under a key
# it was not built from, and the build runs again for the sources as they
# stand — three builds at most, so an edit made while a guard runs costs a
# rebuild, never the guard's answer; sources still moving after the third are
# the cannot-answer exit. The build runs with GOOS, GOARCH and GOFLAGS removed
# from its environment, so it always targets the host and the artifact
# depends only on the hashed sources: a call from a cross-compiling shell
# would otherwise cache a foreign binary every later call execs (exit 126).
# A failed rename exits the cannot-answer code like any other build failure.
#
# CANNOT ANSWER. Anything that stops the binary from being derived — no
# SHA-256 tool, no cache location, no stats/ beside this file's checkout, no
# `go` on PATH, a failed build — prints "<name>: <cause>" to stderr and exits
# the guard's own cannot-answer code: 4 for run-reproducer (whose 2 is
# "refused") and break-and-prove; 2 for every other guard
# and for a call naming none. Never a verdict. `go build`'s own output
# goes to stderr too, so a guard's stdout carries only its verdict lines.
#
# THE STAMP. Its first act exports FLOW_GUARD_START, the $EPOCHREALTIME of
# its start — a bash variable, no fork, a few microseconds — unless a stamp
# was inherited (a CwdCheckout re-exec through another worktree's bootstrap,
# which then counts the whole chain); flow-guard posts the time from it to
# its dispatch as the run's bootstrap_ms and unsets it for its children. A
# bash without $EPOCHREALTIME (3.2) exports it empty: no bootstrap_ms.
#
# Bash 3.2 is the floor (macOS /bin/bash).
export FLOW_GUARD_START="${FLOW_GUARD_START:-${EPOCHREALTIME:-}}"
set -uo pipefail

name="${1:-}"
[ $# -gt 0 ] && shift
case "$name" in
  run-reproducer | break-and-prove) code=4 ;;
  *) code=2 ;;
esac
opening="${name:-flow-guard}:"

# flow_guard_files <stats-dir> — set files to the <stats-dir>-relative names of
# the flow-guard sources the key hashes.
flow_guard_files() {
  files=(go.mod go.sum)
  for f in "$1"/cmd/flow-guard/*.go "$1"/internal/guard/*.go "$1"/internal/records/*.go "$1"/internal/modelpolicy/*.go "$1"/internal/testcost/*.go "$1"/internal/shlex/*.go; do
    case "$f" in *_test.go) ;; *) [ -f "$f" ] && files+=("${f#"$1"/}") ;; esac
  done
}

# flow_guard_key <stats-dir> — print the cache key of the flow-guard sources
# under <stats-dir>, or return non-zero if they cannot be hashed.
flow_guard_key() {
  (
    cd "$1" || exit 1
    flow_guard_files .
    if command -v sha256sum >/dev/null 2>&1; then
      sum() { sha256sum "$@"; }
    elif command -v shasum >/dev/null 2>&1; then
      sum() { shasum -a 256 "$@"; }
    else
      exit 1
    fi
    key="$(sum "${files[@]}" | sum)" || exit 1
    printf '%s\n' "${key%% *}"
  )
}

# A symlink to this file is followed to the file itself before its directory
# is resolved, so a call through a link elsewhere still answers this checkout.
# Parameter expansion stands in for dirname, and the root is resolved by a cd
# in this shell and a cd back, not in a subshell: each fork costs a call about
# a millisecond. readlink has no builtin, so only a link pays one. The cd back
# returns to the caller's own logical directory, $OLDPWD restored, whenever
# $PWD is this directory; a stale or missing $PWD takes the subshell instead.
# CDPATH is cleared, so a relative directory never resolves through it.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink -- "$self")"
  case "$link" in /*) self="$link" ;; *) case "$self" in */*) self="${self%/*}/$link" ;; *) self="$link" ;; esac ;; esac
done
case "$self" in */*) dir="${self%/*}" dir="${dir:-/}" ;; *) dir=. ;; esac
here="${PWD:-}"
if [ -n "$here" ] && [ "$here" -ef . ]; then
  old="${OLDPWD-}" hadold="${OLDPWD+1}"
  CDPATH='' cd -P -- "$dir" && cd .. && root="$PWD" && cd -- "$here" || root=""
  if [ -n "$hadold" ]; then OLDPWD="$old"; else unset OLDPWD; fi
else
  root="$(CDPATH='' cd -P -- "$dir" && cd .. && pwd)" || root=""
fi
[ -n "$root" ] || {
  echo "$opening cannot resolve the checkout of ${BASH_SOURCE[0]}" >&2
  exit "$code"
}
[ -d "$root/stats" ] && [ -x "$root/stats" ] && stats="$root/stats" || {
  echo "$opening cannot build flow-guard — no stats/ source tree beside ${BASH_SOURCE[0]}" >&2
  exit "$code"
}
cache="${FLOW_GUARD_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}}"
if [ -z "$cache" ]; then
  echo "$opening cannot build flow-guard — no cache location (set FLOW_GUARD_CACHE_DIR, XDG_CACHE_HOME or HOME)" >&2
  exit "$code"
fi
[ -n "${FLOW_GUARD_CACHE_DIR:-}" ] || cache="$cache/flow-guard"
# The fast path (THE STAMP FILE above): the stamp's key stands when its file
# list is today's and the stamp is strictly newer than every source.
stamp="$cache/stamp${stats//\//%}"
flow_guard_files "$stats"
key=""
if [ -f "$stamp" ] && { read -r skey && read -r slist; } 2>/dev/null <"$stamp" &&
  [ "$slist" = "${files[*]}" ] && [ -x "$cache/$skey/flow-guard" ]; then
  key="$skey"
  for f in "${files[@]}"; do
    [ -f "$stats/$f" ] && [ "$stamp" -nt "$stats/$f" ] || { key=""; break; }
  done
fi
if [ -z "$key" ]; then
  # Touched before hashing: its mtime is the stamp's, so a source edited from
  # here on is never older than the stamp.
  mkdir -p "$cache" && : >"$stamp.$$" || :
  trap 'rm -f "$stamp.$$" "$stamp.$$.w"' EXIT
  key="$(flow_guard_key "$stats")" || {
    echo "$opening cannot build flow-guard — could not hash its sources in $stats (needs sha256sum or shasum)" >&2
    exit "$code"
  }
  fresh=1
fi
bin="$cache/$key/flow-guard"
if [ ! -x "$bin" ]; then
  if ! command -v go >/dev/null 2>&1; then
    echo "$opening cannot build flow-guard from $stats — no go on PATH" >&2
    exit "$code"
  fi
  built=""
  for _ in 1 2 3; do
    tmp="$bin.$$"
    if ! mkdir -p "$cache/$key" || ! (cd "$stats" && env -u GOOS -u GOARCH -u GOFLAGS go build -o "$tmp" ./cmd/flow-guard) >&2; then
      rm -f "$tmp"
      echo "$opening could not build flow-guard from $stats" >&2
      exit "$code"
    fi
    now="$(flow_guard_key "$stats")" || now=""
    if [ "$now" = "$key" ]; then
      if ! mv -f "$tmp" "$bin"; then
        rm -f "$tmp" || :
        echo "$opening could not install flow-guard into $cache/$key" >&2
        exit "$code"
      fi
      built=1
      break
    fi
    # The sources moved under the build: discard it and build what is there now.
    rm -f "$tmp"
    [ -n "$now" ] || break
    key="$now"
    bin="$cache/$key/flow-guard"
    if [ -x "$bin" ]; then
      built=1
      break
    fi
  done
  if [ -z "$built" ]; then
    echo "$opening flow-guard's sources in $stats changed during its build — run the guard again" >&2
    exit "$code"
  fi
fi
if [ -n "${fresh:-}" ] && [ -f "$stamp.$$" ]; then
  printf '%s\n%s\n' "$key" "${files[*]}" >"$stamp.$$.w" && touch -r "$stamp.$$" "$stamp.$$.w" && mv -f "$stamp.$$.w" "$stamp"
  rm -f "$stamp.$$" "$stamp.$$.w"
fi
export FLOW_GUARD_REPO_ROOT="$root"
[ -n "$name" ] || exec "$bin"
exec "$bin" "$name" "$@"
