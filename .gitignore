.DS_Store
.superpowers/
spectre/changes/

# Serena MCP server workspace metadata — tool artifact, not project source
.serena/

# Python bytecode from the guard wrappers (check-task-*.py)
__pycache__/
*.pyc

# stats/ build output — the Vite SPA build and the compiled daemon/CLI binaries
stats/bin/
stats/web/node_modules/
# Any runner's node_modules (a vitest started at the root writes .vite/ there) and the Playwright MCP's screenshots — tool output, never source.
node_modules/
/.playwright-mcp/
stats/web/dist/
# The Vite build's actual outDir (stats/web/vite.config.ts): inside
# internal/web, not stats/web/dist, so //go:embed can reach it without a
# "../" pattern (see internal/web/embed.go's own doc comment). Not
# committed for the same reason the CLI/daemon binaries above aren't: a
# build with no dist/ present must fail loudly at compile time, not build
# against a stale, committed copy.
stats/internal/web/dist/
# The Allowed pairs table stats/Makefile's policy-copy target copies for
# internal/modelpolicy/embedded/embed.go's //go:embed (KAN-1067) -- a build
# copy of skills/flow-contracts/model-policy.md, never a second source; the
# trailing * covers the temp file it is renamed from.
stats/internal/modelpolicy/embedded/model-policy.md*
stats/web/tsconfig.tsbuildinfo

# Playwright's own run artifacts (stats/web/tests/visual, KAN-171) --
# failure diffs/traces and the HTML reporter, never the committed baseline
# PNGs under tests/visual/baseline.spec.ts-snapshots/, which this pattern
# does not match.
stats/web/test-results/
stats/web/playwright-report/
stats/web/blob-report/

# IntelliJ project state -- IDE state, never source
.idea/

# Per-project skill symlinks installed by the operator (Go skills from ~/.agents/skills) — machine-local
.claude/skills/

# Claude Code writes each mod's API typings here on load — generated, not source
mods/*/.claude-plugin/types/
