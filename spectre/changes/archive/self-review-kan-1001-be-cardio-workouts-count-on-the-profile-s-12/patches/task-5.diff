+package com.gymie.gradle
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+
+class BootRunArgsTest {
+    @Test
+    fun `every value of a workspace bootRun goes on the command line, the seed run's flags beside them`() {
+        val args =
+            bootRunArgs(
+                port = 18080,
+                jdbcUrl = "jdbc:postgresql://localhost:5432/gymie_kan_1_demo_abcd",
+                bucket = "gymie-media-kan-1-demo-abcd",
+                storageEndpoint = "http://localhost:9000",
+                cacheIndex = 3,
+                extra = listOf("--app.seed.enabled=true"),
+            )
+
+        assertEquals(
+            "--spring.profiles.active=local --server.port=18080 " +
+                "--spring.datasource.url=jdbc:postgresql://localhost:5432/gymie_kan_1_demo_abcd " +
+                "--app.seed.enabled=true " +
+                "--gymie.storage.bucket=gymie-media-kan-1-demo-abcd " +
+                "--gymie.storage.endpoint=http://localhost:9000 " +
+                "--gymie.storage.public-base-url=http://localhost:9000/gymie-media-kan-1-demo-abcd " +
+                "--spring.data.redis.database=3 " +
+                "--spring.security.oauth2.client.registration.google.client-id=local-dev-placeholder-client-id " +
+                "--spring.security.oauth2.client.registration.google.client-secret=local-dev-placeholder-client-secret",
+            args,
+        )
+    }
+}
