@@ -0,0 +1,32 @@
+package com.gymie.gradle
+
+/**
+ * The `--args` value of a local `:app:bootRun` against one workspace. Every value goes on the command
+ * line because the Gradle daemon's environment is fixed when it starts (`seedDatabase`,
+ * `gradle/dev-lifecycle.gradle.kts`, says why value by value). `dbSeed`'s seed run and
+ * `devBootRunArgs` both build it here, so a before-figure backend (`.flow/project.md`, `## run`) runs
+ * on exactly the arguments the seed run does; [extra] carries the seed run's own flags.
+ */
+fun bootRunArgs(
+    port: Int,
+    jdbcUrl: String,
+    bucket: String,
+    storageEndpoint: String,
+    cacheIndex: Int,
+    extra: List<String> = emptyList(),
+): String =
+    (
+        listOf(
+            "--spring.profiles.active=local",
+            "--server.port=$port",
+            "--spring.datasource.url=$jdbcUrl",
+        ) + extra +
+            listOf(
+                "--gymie.storage.bucket=$bucket",
+                "--gymie.storage.endpoint=$storageEndpoint",
+                "--gymie.storage.public-base-url=$storageEndpoint/$bucket",
+                "--spring.data.redis.database=$cacheIndex",
+                "--spring.security.oauth2.client.registration.google.client-id=local-dev-placeholder-client-id",
+                "--spring.security.oauth2.client.registration.google.client-secret=local-dev-placeholder-client-secret",
+            )
+    ).joinToString(" ")
