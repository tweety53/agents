+/**
+ * The `--args` value of a `:app:bootRun` against [workspace]'s resources, [bootRunArgs] filled in.
+ *
+ * The bucket is derived from the same workspace `ensureWorkspaceResources` provisions, so the bucket
+ * the run is told about is the one that actually exists — never hardcoded, and never the empty string
+ * an inherited STORAGE_* variable would otherwise pass through to defeat `application-local.yml`'s
+ * `${STORAGE_BUCKET:gymie-media}`-shaped defaults. An empty inherited REDIS_DATABASE defeats
+ * `${REDIS_DATABASE:0}` the same way, failing Spring's *type* conversion rather than Bean Validation;
+ * `resolveCacheIndex` is the same claim `devStart` makes for this workspace, so the run talks to the
+ * Redis index the rest of the stack does. A daemon that inherited an empty GOOGLE_CLIENT_ID defeats
+ * `application-local.yml`'s placeholder and the run dies building the OAuth client; it signs nobody
+ * in, so the placeholders are passed outright.
+ */
+fun Project.workspaceBootRunArgs(
+    workspace: Workspace,
+    pgDb: String,
+    port: Int,
+    extra: List<String> = emptyList(),
+): String =
+    bootRunArgs(
+        port = port,
+        jdbcUrl = workspaceJdbcUrl(pgDb),
+        bucket = workspace.bucket,
+        storageEndpoint = workspaceStorageEndpoint,
+        cacheIndex = resolveCacheIndex(workspace),
+        extra = extra,
+    )
+
+// Prints the `--args=` of a `:app:bootRun` against this checkout's workspace, from the same
+// `workspaceBootRunArgs` the seed run uses — the before-figure backend of `.flow/project.md`'s
+// `## run`. Run with `-q`: the line goes to stdout through `println` and is the only output.
+tasks.register("devBootRunArgs") {
+    group = "gymie dev"
+    description = "Print the --args= of a :app:bootRun against this workspace — -PbootPort=<free port>, run with -q"
+    doLast {
+        val port =
+            project.findProperty("bootPort")?.toString()?.toIntOrNull()
+                ?: throw GradleException("-PbootPort=<free port> is required")
+        println("--args=" + project.workspaceBootRunArgs(project.workspace(), project.resolvePgDb(), port))
+    }
+}
