 fun Recorded<Map<String, Int>>.withoutStaleOAuthPinnedEntries(
+    deterministic: Map<String, Int>,
     binding: Set<String>,
     running: Set<String>,
 ): Recorded<Map<String, Int>> {
     val placed = (this as? Recorded.Value)?.value ?: return this
     val stale =
         OAUTH_PINNED_SERVICE_NAMES.filter { name ->
-            name in placed && !(name in running && name !in binding)
