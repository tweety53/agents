+package guard
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+// stfRepo is a fixture worktree shaped like kan-1012's task 2: a tracked file
+// edited, new files under directories git has never seen, and an edited
+// spectre/changes/ file the task does not name.
+func stfRepo(t *testing.T, g *fxGit, wt string) []string {
+	t.Helper()
+	g.git("", "init", "-q", "-b", "work", wt)
+	for _, d := range []string{"/src/app/template/src/test/x", "/src/app/template/src/main/k/l", "/spectre/changes/c"} {
+		mkdir(t, wt+d)
+	}
+	g.write(wt+"/src/app/template/src/test/x/T.kt", "base")
+	g.write(wt+"/spectre/changes/c/tasks.md", "base")
+	g.git(wt, "add", ".")
+	g.git(wt, "commit", "-qm", "base")
+	g.write(wt+"/src/app/template/src/test/x/T.kt", "edited")
+	g.write(wt+"/spectre/changes/c/tasks.md", "ticked")
+	g.write(wt+"/src/app/template/src/main/k/A.kt", "new")
+	g.write(wt+"/src/app/template/src/main/k/l/B.kt", "new")
+	return []string{"src/app/template/src/main/k/A.kt", "src/app/template/src/main/k/l/B.kt", "src/app/template/src/test/x/T.kt"}
+}
+
+// Every named path is staged, the new ones under unseen directories
+// included, and the unnamed planning edit is not. With the excludes after
+// the paths, git 2.50.1 stages T.kt alone on this layout and exits 0.
+func TestStageTaskFilesStagesNewFilesUnderNewDirectories(t *testing.T) {
+	t.Parallel()
+	dir := t.TempDir()
+	var g fxGit
+	files := stfRepo(t, &g, dir+"/wt")
+	if g.err != nil {
+		t.Fatal(g.err)
+	}
+	r := runGuard("stage-task-files", append([]string{dir + "/wt"}, files...), Env{Dir: dir, Getenv: os.Getenv})
+	if r.rc != 0 {
+		t.Fatalf("exit %d, want 0\n%s", r.rc, r.out)
+	}
+	staged := g.git(dir+"/wt", "diff", "--cached", "--name-only")
+	if staged != strings.Join(files, "\n") {
+		t.Errorf("staged:\n%s\nwant:\n%s", staged, strings.Join(files, "\n"))
+	}
+}
+
+// An add that exits 0 having staged nothing is refused, naming each path.
+func TestStageTaskFilesRefusesAPathLeftUnstaged(t *testing.T) {
+	t.Parallel()
+	dir := t.TempDir()
+	var g fxGit
+	files := stfRepo(t, &g, dir+"/wt")
+	if g.err != nil {
+		t.Fatal(g.err)
+	}
+	writeExec(t, dir+"/bin/git", "#!/usr/bin/env bash\nfor a in \"$@\"; do [ \"$a\" = add ] && exit 0; done\nexec "+fixtureGit+" \"$@\"\n")
+	env := Env{Dir: dir, Getenv: func(k string) string {
+		if k == "PATH" {
+			return dir + "/bin:" + os.Getenv("PATH")
+		}
+		return os.Getenv(k)
+	}}
+	r := runGuard("stage-task-files", append([]string{dir + "/wt"}, files...), env)
+	if r.rc != 1 {
+		t.Fatalf("exit %d, want 1\n%s", r.rc, r.out)
+	}
+	for _, want := range []string{"?? src/app/template/src/main/k/A.kt", "?? src/app/template/src/main/k/l/B.kt", " M src/app/template/src/test/x/T.kt"} {
+		if !strings.Contains(r.out, want) {
+			t.Errorf("output lacks %q:\n%s", want, r.out)
+		}
+	}
+}
diff --git a/stats/internal/guard/stagetaskfiles.go b/stats/internal/guard/stagetaskfiles.go
new file mode 100644
index 00000000..49276f35
--- /dev/null
+++ b/stats/internal/guard/stagetaskfiles.go
@@ -0,0 +1,72 @@
+package guard
+
+import (
+	"fmt"
+	"io"
+	"strings"
+)
+
+// stageTaskFiles is scripts/stage-task-files.sh: that script's header is the
+// contract -- the staging half of a /flow implementer's per-task commit
+// (skills/flow/implement.md, FLOW — COMMIT-PER-TASK), refusing to hand the
+// commit a task path git left unstaged.
+func init() { Registry["stage-task-files"] = stageTaskFiles }
+
+// stfPlanning is what the clearing reset unstages and the add excludes: both
+// spec-tree leaf spellings and the superpowers notes.
+var stfPlanning = []string{"spectre/changes/", "openspec/changes/", "docs/superpowers/"}
+
+func stageTaskFiles(args []string, env Env, stdout, stderr io.Writer) int {
+	if len(args) < 2 {
+		fmt.Fprint(stderr, "usage: stage-task-files.sh <abs-worktree> <file>...\n")
+		return 2
+	}
+	wt, files := args[0], args[1:]
+	if !isDir(smcAbs(env, wt)) {
+		fmt.Fprintf(stderr, "stage-task-files: %s is not a directory\n", wt)
+		return 2
+	}
+	gitBin, ok := panelResolveGit(env, "stage-task-files", stderr)
+	if !ok {
+		return 2
+	}
+	add := []string{"add", "--"}
+	for _, p := range stfPlanning {
+		add = append(add, ":(exclude)"+p)
+	}
+	// The excludes lead the paths: git 2.50.1 given the task's paths first
+	// and an exclude after them stages tracked paths alone and exits 0
+	// (kan-1012 self-review).
+	for _, step := range [][]string{append([]string{"reset", "-q", "--"}, stfPlanning...), append(add, files...)} {
+		if out, err := panelGit(env, gitBin, wt, step...).CombinedOutput(); err != nil {
+			fmt.Fprintf(stderr, "stage-task-files: git %s failed in %s:\n%s", step[0], wt, out)
+			return 2
+		}
+	}
+	out, err := panelGit(env, gitBin, wt, append([]string{"status", "--porcelain", "--untracked-files=all", "--"}, files...)...).Output()
+	if err != nil {
+		fmt.Fprintf(stderr, "stage-task-files: git status failed in %s\n", wt)
+		return 2
+	}
+	var left []string
+	for _, l := range strings.Split(strings.TrimRight(string(out), "\n"), "\n") {
+		if len(l) < 4 || l[1] == ' ' || stfIsPlanning(l[3:]) {
+			continue
+		}
+		left = append(left, l)
+	}
+	if len(left) > 0 {
+		fmt.Fprintf(stderr, "stage-task-files: git add exited 0 and left %d task path(s) unstaged — commit nothing, report this:\n%s\n", len(left), strings.Join(left, "\n"))
+		return 1
+	}
+	return 0
+}
+
+func stfIsPlanning(path string) bool {
+	for _, p := range stfPlanning {
+		if strings.HasPrefix(path, p) {
+			return true
+		}
+	}
+	return false
+}
