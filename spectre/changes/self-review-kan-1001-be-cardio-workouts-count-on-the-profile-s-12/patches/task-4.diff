--- /dev/null
+++ b/scripts/test-env-link-wiring.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# Regression check for the `.env` link the seeding tasks depend on (gradle/git-hooks.gradle.kts).
+#
+# `dbSeed` and `devWorkspaceCreate` seed a fresh worktree's database, and the seed reads
+# DEV_INVITE_EMAIL from `.env`; `linkEnvFile` symlinks the main checkout's `.env` into a worktree.
+# Wired to `devStart` alone, a worktree seeded before its first `devStart` carried no developer
+# invite and no friend cast (kan-1001's self-review). A dry run (`-m`) prints every task the
+# invocation would execute and runs none of them, so this asserts the task graph itself.
+
+set -euo pipefail
+
+repo_root=$(cd "$(dirname "$0")/.." && pwd)
+failures=0
+
+for task in dbSeed devWorkspaceCreate devStart; do
+  graph=$(cd "$repo_root" && ./gradlew -q -m "$task")
+  if grep -qx ':linkEnvFile SKIPPED' <<<"$graph"; then
+    echo "ok: $task runs linkEnvFile first"
+  else
+    echo "FAIL: $task does not run linkEnvFile; its dry run was:" >&2
+    echo "$graph" >&2
+    failures=$((failures + 1))
+  fi
+done
+
+if [ "$failures" -gt 0 ]; then
+  exit 1
+fi
+echo "all env-link wiring cases pass"
