+/**
+ * Whether a run without [ISOLATE_OAUTH_PORTS_PROPERTY] keeps the isolation the running stack was started
+ * with: true when a running [OAUTH_PINNED_SERVICE_NAMES] member's [recorded] port is not its [declared] one.
+ *
+ * **A restart is not a choice to give the OAuth ports back** (kan-970 self-review). `devRestart` and a bare
+ * `devStart` read only their own invocation's properties, so restarting an isolated stack without the flag
+ * moved its frontend and gateway onto the declared ports — the main checkout's — while every caller that
+ * read the record before the restart believed the stack still isolated. Inheriting from what is running
+ * keeps a restart where the stack was; giving the ports back is `devStop` first, after which nothing is
+ * running to inherit from.
+ */
+fun inheritsOAuthIsolation(
+    recorded: Recorded<Map<String, Int>>,
+    declared: Map<String, Int>,
+    running: Set<String>,
+): Boolean {
+    val placed = (recorded as? Recorded.Value)?.value ?: return false
+    return OAUTH_PINNED_SERVICE_NAMES.any { name -> name in running && placed[name]?.let { it != declared[name] } == true }
+}
