+fun Project.isolateOAuthPorts(): Boolean {
+    if (findProperty(ISOLATE_OAUTH_PORTS_PROPERTY) != null) return true
+    // Decided once per invocation, before anything is stopped: a restart's stop loop takes down the very
+    // services this answer is read from, and the environment its starts export must agree with the
+    // block resolved ahead of it. buildSrc's [inheritsOAuthIsolation] carries the rule.
+    val extra = extensions.extraProperties
+    if (!extra.has(INHERITED_OAUTH_ISOLATION_KEY)) {
+        val declared = services.mapNotNull { service -> service.port?.let { service.name to it } }.toMap()
+        val inherited = inheritsOAuthIsolation(recordedPortBlock(), declared, runningServiceNames(services))
+        if (inherited) {
+            logger.lifecycle(
+                "Keeping -P$ISOLATE_OAUTH_PORTS_PROPERTY: this workspace's frontend or gateway is running on a moved port. " +
+                    "Run devStop first to give the declared OAuth ports back.",
+            )
+        }
+        extra.set(INHERITED_OAUTH_ISOLATION_KEY, inherited)
+    }
+    return extra.get(INHERITED_OAUTH_ISOLATION_KEY) as Boolean
+}
